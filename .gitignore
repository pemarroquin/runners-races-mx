# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: 'node_modules/' matches only DIRECTORIES, so a
# node_modules SYMLINK (one gets created when typechecking a git worktree
# that has no install of its own) slipped straight past it and was committed.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# web deploy build artifacts (rebuilt on demand, not source)
deploy/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

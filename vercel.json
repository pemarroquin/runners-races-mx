{
  "crons": [
    { "path": "/api/territory-analysis", "schedule": "30 10 * * 1" }
  ],
  "buildCommand": "node scripts/check-web-env.mjs && npx expo export -p web && cp 'dist/race/[id].html' dist/race/_detail.html",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [{ "source": "/race/:id", "destination": "/race/_detail" }],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
